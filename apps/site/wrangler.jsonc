{
  "name": "tokenburn",
  "main": "src/index.ts",
  "compatibility_date": "2025-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "routes": [{ "pattern": "tokenburn.astonlu.com", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false,
  "d1_databases": [
    { "binding": "DB", "database_name": "tokenburn", "database_id": "02009f43-9941-43f8-9875-eb5835dd4822", "migrations_dir": "migrations" }
  ],
  "rules": [{ "type": "Data", "globs": ["**/*.woff", "**/*.woff2"], "fallthrough": true }, { "type": "Text", "globs": ["**/*.html"], "fallthrough": true }],
  "observability": { "enabled": true }
}
