{
  "name": "tokenburn",
  "main": "src/index.ts",
  "compatibility_date": "2025-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": ["/api/*", "/u/*"] },
  "d1_databases": [
    { "binding": "DB", "database_name": "tokenburn", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "migrations" }
  ],
  "rules": [{ "type": "Data", "globs": ["**/*.woff"], "fallthrough": true }],
  "observability": { "enabled": true }
}
