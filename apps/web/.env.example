# Upstash Redis REST credentials. When unset, an in-memory store is used (dev only;
# `next start` refuses unless TOKENBURN_ALLOW_MEMORY_STORE=1).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Public origin used for absolute OG image URLs.
TOKENBURN_PUBLIC_URL=http://localhost:3000
# TOKENBURN_ALLOW_MEMORY_STORE=1
